# GROQ_API_KEY: Required for Groq Llama 3 API calls and Whisper.
# Users configure this via the Secrets panel in the AI Studio UI.
GROQ_API_KEY="your-groq-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Provider-neutral Structured Understanding. Shadow is observation-only. Controlled
# adoption is separately opt-in and may only supplement time, confirmation, and contact.
STRUCTURED_UNDERSTANDING_ENABLED="false"
STRUCTURED_UNDERSTANDING_SHADOW_MODE="false"
STRUCTURED_UNDERSTANDING_ADOPTION_ENABLED="false"
STRUCTURED_UNDERSTANDING_SHADOW_MAX_CONCURRENCY="2"
STRUCTURED_UNDERSTANDING_PROVIDER="gemini"
STRUCTURED_UNDERSTANDING_MODEL="gemini-2.5-flash"
STRUCTURED_UNDERSTANDING_TIMEOUT_MS="2500"
# Opt-in safe SDK failure metadata only; never emits prompts or provider payloads.
STRUCTURED_UNDERSTANDING_PROVIDER_DIAGNOSTICS="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Calendar Service Account Credentials
GOOGLE_CALENDAR_ID="my_calendar_id@group.calendar.google.com"
GOOGLE_CLIENT_EMAIL="my-bot@my-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supabase Realtime Database
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# Browser-safe Supabase Auth values embedded by Vite at build time.
# These must refer to the same Supabase project as the server values above.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Server-only secret for tenant-separated analytics customer-key HMAC.
# Use at least 32 random bytes. Never expose this through a VITE_ variable.
ANALYTICS_HASH_SECRET=""

# Optional server default; each reconciliation run must provide this or `from`.
# Use an ISO-8601 UTC timestamp; never infer a boundary from stored event rows.
ANALYTICS_RECONCILIATION_FROM="2026-01-01T00:00:00.000Z"

# Canonical test bridge. Disabled by default; enable only in an isolated test environment.
# The token is server-only, mandatory while enabled, and must contain at least 32 bytes.
# Generate a dedicated random value; never reuse a provider or user credential.
ODINLINK_TEST_BRIDGE_ENABLED="false"
ODINLINK_TEST_BRIDGE_TOKEN=""
# Optional durable test-execution expiry (milliseconds), clamped to 1 minute–24 hours.
ODINLINK_TEST_EXECUTION_TTL_MS="1800000"

# Admin Telegram ID (for feedback notifications)
ADMIN_TELEGRAM_ID="your-admin-telegram-chat-id"

# Instagram Webhook Configuration
INSTAGRAM_VERIFY_TOKEN="your-random-verification-string-like-laser123"
INSTAGRAM_ACCESS_TOKEN="your-meta-graph-api-page-access-token"
INSTAGRAM_PAGE_ACCESS_TOKEN="your-meta-graph-api-page-access-token"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_TOKEN="your-telegram-bot-token"
# Exhausted failed booking claims start a new three-attempt epoch after this
# cooldown. Values below the immediate retry delay are clamped to that delay.
IDEMPOTENCY_EXHAUSTED_BOOKING_COOLDOWN_MS=900000
