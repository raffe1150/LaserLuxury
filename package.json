{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/knowledge/documents/extraction-child.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/knowledge-extractor.cjs && esbuild src/knowledge/documents/extraction-supervisor.cjs --bundle --platform=node --format=cjs --outfile=dist/knowledge-extraction-supervisor.cjs",
    "knowledge:backfill-embeddings": "tsx scripts/knowledge-embedding-backfill.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test:business-tone": "node tests/business-tone-update.vite.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "csv-parse": "7.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "fast-xml-parser": "5.11.2",
    "form-data": "^4.0.5",
    "googleapis": "^173.0.0",
    "groq-sdk": "^1.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.2.1",
    "node-edge-tts": "^1.2.10",
    "openai": "^6.42.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/yauzl": "2.10.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "proxy-addr": "2.0.8"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
